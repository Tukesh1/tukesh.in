# GitHub Personal Access Token (optional — raises rate limit from 10 to 30 req/min)
# Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Permissions: Contents (read) + Metadata (read)
GITHUB_TOKEN=PUT_YOUR_GITHUB_TOKEN_HERE

# WakaTime API key (required for coding-session stats on /activity)
# https://wakatime.com/settings/api-key
WAKATIME_API_KEY=PUT_YOUR_WAKATIME_API_KEY_HERE

# ────────────────────────────────────────────────────────────────────────────
# Guestbook — /guestbook
# ────────────────────────────────────────────────────────────────────────────

# Auth.js secret — generate with: `openssl rand -base64 32`
AUTH_SECRET=PUT_A_RANDOM_32_CHAR_STRING_HERE

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → New OAuth App
#   Homepage URL:          https://tukesh.in           (or http://localhost:3000 for dev)
#   Authorization callback: https://tukesh.in/api/auth/callback/github
AUTH_GITHUB_ID=PUT_YOUR_GITHUB_CLIENT_ID_HERE
AUTH_GITHUB_SECRET=PUT_YOUR_GITHUB_CLIENT_SECRET_HERE

# Upstash Redis — free tier works great
# Create a database at: https://console.upstash.com/redis
# Copy the REST URL and REST token from the database details page.
UPSTASH_REDIS_REST_URL=PUT_YOUR_UPSTASH_REDIS_REST_URL_HERE
UPSTASH_REDIS_REST_TOKEN=PUT_YOUR_UPSTASH_REDIS_REST_TOKEN_HERE

# GitHub username with admin powers (pin/unpin + delete any message).
# Leave empty to disable admin features.
ADMIN_GITHUB_USERNAME=PUT_YOUR_GITHUB_USERNAME_HERE

# Auth.js host trust.
# - Vercel is auto-detected; leave this unset there.
# - For other hosts (Coolify, Railway, Docker behind nginx, …) either set
#   AUTH_URL to your canonical site URL, or uncomment the opt-in below.
#   Only enable when your reverse proxy sanitizes the Host header.
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.com